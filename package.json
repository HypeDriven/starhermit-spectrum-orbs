{
  "name": "spectrum-orbs",
  "version": "1.0.0",
  "description": "Spectrum Orbs — a kinetic sculpture gallery ordering puzzle on the StarHermit engine.",
  "private": true,
  "scripts": {
    "test": "npm run test:unit && npm run test:native",
    "test:unit": "node --test tests/rules.test.js tests/server.test.js tests/progress.test.mjs tests/i18n.test.mjs",
    "test:native": "node tests/native.mjs",
    "test:browser": "node tools/browser-play.mjs .",
    "start": "node server.js",
    "package": "node tools/package-web.mjs",
    "css": "node tools/css.mjs",
    "textures": "node tools/bake-textures.mjs",
    "plays": "node tools/gen-plays.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
