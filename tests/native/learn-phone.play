# Generated by tools/gen-plays.mjs: the five lessons on a DPR-3 phone by finger on the tube labels and the tray (lift & pour, a mismatched pour, any pour, a pour undone, the winning pour).
# viewport 390x844@3
until 600 Daily Challenge
frames 30
touch =Learn to Play
until 300 Lesson 1 of 5
frames 30
save learn-1
# 1: any pour
touch =Tube 1
frames 8
touch =Tube 3
until 300 Lesson 2 of 5
frames 30
# 2: colours must match (a pour onto the empty tube, then tube 1's other colour onto it)
touch =Tube 1
frames 8
touch =Tube 3
frames 40
touch =Tube 1
frames 8
touch =Tube 3
until 300 Lesson 3 of 5
frames 30
save learn-3
# 3: any pour
touch =Tube 2
frames 8
touch =Tube 3
until 300 Lesson 4 of 5
frames 30
# 4: a pour, then Undo on the tray
touch =Tube 1
frames 8
touch =Tube 3
frames 40
touch =Undo
until 300 Lesson 5 of 5
frames 30
save learn-5
# 5: the winning pour
touch =Tube 3
frames 8
touch =Tube 2
until 600 Daily Challenge
frames 20
expect Lessons complete
save learn-done
